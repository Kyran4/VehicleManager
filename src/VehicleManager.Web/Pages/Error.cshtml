@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<h1 class="h3">@Model.Heading</h1>
<p>@Model.Message</p>
@if (Model.StatusCode != 404)
{
    <p class="text-muted small">Reference: <code>@Model.RequestId</code></p>
}
<a class="btn btn-primary" asp-page="/Index">Back to vehicles</a>
